import sys


def count_lines(text):
    return len(text.splitlines())


def count_chars(text):
    n = 0
    for ch in text:
        if not ch.isspace():
            n += 1
    return n

def count_text(num):
    uni=ord(num)
    if 0x0030 <= uni <= 0x0039:
      return "数字"
    if 0x0041 <= uni <= 0x005A:
      return "大英字"
    if 0x0061 <= uni <= 0x007A:
      return "小英字"
    if 0x0041 <= uni <= 0x005A or 0x0061 <= num <= 0x007A:
      return "英字"
    return "その他"

def count_word(text):
    counts={"数字":0,"大英字":0,"小英字":0,"英字":0,"その他":0}
    for num in text:
        if not num.isspace():
            counts[count_text(num)] += 1
    return counts

def main():
    if len(sys.argv) < 2:
        print("使い方: textstat lines|chars|kinds [N]", file=sys.stderr)
        sys.exit(1)
    stat = sys.argv[1]
    text = sys.stdin.read()
    
    if stat == "lines":
        print(count_lines(text))
    elif stat == "chars":
        print(count_chars(text))
    elif stat == "kinds":
        for name, num in count_word(text).items():
            print(f"{name}\t{num}")

if __name__ == "__main__":
    main()

import sys


def count_lines(text):
    return len(text.splitlines())


def count_chars(text):
    n = 0
    for ch in text:
        if not ch.isspace():
            n += 1
    return n

def count_text(num)
    uni=ord(num)
    if 0x0030 <= num <= 0x0039
      return "数字"
    if 0x0041 <= num <= 0x005A
      return "大英字"
    if 0x0061 <= num <= 0x007A
      return "小英字"
    if 0x0041 <= num <= 0x005A or 0x0061 <= num <= 0x007A
      return "英字"
